{
  "name": "@fibex-rrhh/self-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/infrastructure/database/migration-data-source.ts",
    "migration:run:dist": "typeorm migration:run -d dist/shared/infrastructure/database/migration-data-source.js",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/infrastructure/database/migration-data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/shared/infrastructure/database/migration-data-source.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "amqplib": "^0.10.4",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.0",
    "decimal.js": "^10.4.3",
    "envalid": "^8.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.20",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
